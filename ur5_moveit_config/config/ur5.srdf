<?xml version='1.0' encoding='utf-8'?>
<robot name="ur5">

    <group name="arm">
        <chain base_link="base_link" tip_link="tool0" />
    </group>

    <group name="robotiq_gripper">
        <joint name="robotiq_85_left_knuckle_joint" />
    </group>

    <end_effector name="robotiq_gripper" parent_link="tool0" group="robotiq_gripper" parent_group="arm" />

    <group_state name="home" group="arm">
        <joint name="elbow_joint" value="-0.538" />
        <joint name="shoulder_lift_joint" value="-0.5207" />
        <joint name="shoulder_pan_joint" value="-0.8678" />
        <joint name="wrist_1_joint" value="-2.0481" />
        <joint name="wrist_2_joint" value="-2.0481" />
        <joint name="wrist_3_joint" value="3.4366" />
    </group_state>
    <group_state name="straight" group="arm">
        <joint name="elbow_joint" value="0.0868" />
        <joint name="shoulder_lift_joint" value="-1.4927" />
        <joint name="shoulder_pan_joint" value="-3.2283" />
        <joint name="wrist_1_joint" value="-1.4232" />
        <joint name="wrist_2_joint" value="-6.2137" />
        <joint name="wrist_3_joint" value="1.6315" />
    </group_state>
    <!-- Pick pose: captured from Ignition Fortress /joint_states on 2026-10-04
         shoulder_pan=0.9860, shoulder_lift=-1.9385, elbow=-1.8922,
         wrist_1=-0.8457, wrist_2=-4.6883, wrist_3=-5.1156 -->
    <group_state name="pick" group="arm">
        <joint name="shoulder_pan_joint"  value="0.9860" />
        <joint name="shoulder_lift_joint" value="-1.9385" />
        <joint name="elbow_joint"         value="-1.8922" />
        <joint name="wrist_1_joint"       value="-0.8457" />
        <joint name="wrist_2_joint"       value="-4.6883" />
        <joint name="wrist_3_joint"       value="-5.1156" />
    </group_state>
    <!-- Place pose: tool0 at (0.391, 0.336, 0.240) world frame,
         RPY ~(177°, -0.15°, 108.7°) — gripper pointing down toward tray -->
    <group_state name="place" group="arm">
        <joint name="shoulder_pan_joint"  value="0.5542" />
        <joint name="shoulder_lift_joint" value="-1.3999" />
        <joint name="elbow_joint"         value="1.9631" />
        <joint name="wrist_1_joint"       value="-2.1966" />
        <joint name="wrist_2_joint"       value="-1.5017" />
        <joint name="wrist_3_joint"       value="-1.2536" />
    </group_state>
    <group_state name="open" group="robotiq_gripper">
        <joint name="robotiq_85_left_knuckle_joint" value="0.0" />
    </group_state>
    <group_state name="close" group="robotiq_gripper">
        <joint name="robotiq_85_left_knuckle_joint" value="0.8" />
    </group_state>

<disable_collisions link1="world" link2="base_link" reason="Adjacent" />
<disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent" />
<disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent" />
<disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
<disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent" />
<disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent" />
<disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent" />
<disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent" />
<disable_collisions link1="wrist_3_link" link2="ft_frame" reason="Adjacent" />
<disable_collisions link1="base_link" link2="base" reason="Adjacent" />
<disable_collisions link1="wrist_3_link" link2="flange" reason="Adjacent" />
<disable_collisions link1="flange" link2="tool0" reason="Adjacent" />

<!-- Gripper collision disables -->
<disable_collisions link1="robotiq_85_base_link" link2="wrist_1_link" reason="Never" />
