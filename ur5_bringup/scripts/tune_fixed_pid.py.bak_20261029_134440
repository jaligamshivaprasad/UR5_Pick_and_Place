#!/usr/bin/env python3
"""Isolated Gazebo commissioning and bounded fixed-PID search (ROS 2 Humble).

Never edits the production controller YAML. Each candidate starts a fresh world,
loads its YAML before controller configuration, verifies readback/claims, then
passes hold and small-motion gates before replaying the unchanged saved path.
This is a simulation experiment runner, not a real-time safety controller.
"""
import argparse
import copy
import csv
import hashlib
import json
import math
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

import numpy as np
import yaml

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'ur5_data_logger'))
from ur5_data_logger.schema import CSV_COLUMNS, JOINTS
from ur5_data_logger.fk import VerifiedFK

LIMITS = np.array([150., 150., 150., 28., 28., 28.])
# Commissioning seeds considering gravity, link inertias, and discrete 100 Hz stability:
SEED = {
    'shoulder_pan_joint': dict(p=180., i=5., d=6.0, i_clamp=40., ff_velocity_scale=0.),
    'shoulder_lift_joint': dict(p=500., i=18., d=14.0, i_clamp=70., ff_velocity_scale=0.),
    'elbow_joint': dict(p=240., i=12., d=5.5, i_clamp=32., ff_velocity_scale=0.),
    'wrist_1_joint': dict(p=40., i=3., d=0.70, i_clamp=12., ff_velocity_scale=0.),
    'wrist_2_joint': dict(p=45., i=3.0, d=0.45, i_clamp=15., ff_velocity_scale=0.),
    'wrist_3_joint': dict(p=8., i=0.8, d=0.07, i_clamp=4., ff_velocity_scale=0.),
}
BOUNDS = {
    'p': ([100., 300., 150., 20., 20., 3.], [300., 800., 450., 70., 70., 14.]),
    'd': ([3., 8., 3., 0.3, 0.2, 0.03], [10., 20., 9., 0.70, 0.45, 0.07]),
    'i': ([1., 8., 5., 1., 1., 0.2], [12., 40., 30., 6.0, 6.0, 2.0]),
}


def read_path(path):
    segments = []
    for line in Path(path).read_text().splitlines():
        fields = line.split()
        if not fields or fields[0].startswith('#'):
            continue
        if fields[0] == 'SEGMENT':
            segments.append({'name': fields[1], 'points': []})
        elif fields[0] == 'JOINTS':
            if fields[1:] != list(JOINTS):
                raise ValueError('saved path joint ordering mismatch')
        elif fields[0] == 'POINTS':
            segments[-1]['count'] = int(fields[1])
        elif fields[0] == 'POINT':
            if len(fields) != 24 or fields[3] != 'POS' or fields[10] != 'VEL' or fields[17] != 'ACC':
                raise ValueError('invalid saved point')
            sec, ns = int(fields[1]), int(fields[2])
            if sec < 0 or not 0 <= ns < 1000000000:
                raise ValueError('invalid saved timestamp')
            point = (sec + ns * 1e-9, list(map(float, fields[4:10])),
                     list(map(float, fields[11:17])), list(map(float, fields[18:24])))
            if not np.isfinite(np.array(point[1:])).all():
                raise ValueError('nonfinite saved point')
            segments[-1]['points'].append(point)
    if not segments:
        raise ValueError('empty saved path')
    for s in segments:
        pts = s['points']
        if len(pts) != s['count'] or len(pts) < 2 or pts[0][0] != 0 or any(b[0] <= a[0] for a, b in zip(pts, pts[1:])):
            raise ValueError('invalid saved point count/times')
    for a, b in zip(segments, segments[1:]):
        if np.max(np.abs(np.array(a['points'][-1][1]) - b['points'][0][1])) > .02:
            raise ValueError('discontinuous saved segments')
    return segments


def stop_group(proc):
    if proc is None:
        return
    try:
        pgid = os.getpgid(proc.pid)
    except Exception:
        pgid = None
    for sig, timeout in [(signal.SIGINT, 8), (signal.SIGTERM, 4), (signal.SIGKILL, 2)]:
        if pgid is not None:
            try:
                os.killpg(pgid, sig)
            except ProcessLookupError:
                break
        try:
            proc.wait(timeout=timeout)
            break
        except subprocess.TimeoutExpired:
            continue
    try:
        subprocess.run(['pkill', '-9', '-P', str(proc.pid)], capture_output=True, timeout=2)
    except Exception:
        pass


def worker(args):
    import rclpy
    from rclpy.node import Node
    from rclpy.qos import QoSProfile, DurabilityPolicy
    from rclpy.action import ActionClient
    from rcl_interfaces.srv import GetParameters
    from controller_manager_msgs.srv import ListControllers, ListHardwareInterfaces, SwitchController
    from control_msgs.msg import JointTrajectoryControllerState
    from control_msgs.action import FollowJointTrajectory
    from std_msgs.msg import String
    from trajectory_msgs.msg import JointTrajectoryPoint
    from builtin_interfaces.msg import Duration

    out = Path(args.output).resolve()
    config = yaml.safe_load(Path(args.config).read_text())
    gains = config['arm_controller']['ros__parameters'].get('gains', {})
    segments = read_path(args.path)
    rclpy.init()
    node = Node('fixed_pid_trial')
    records, states = [], []
    phase = 'startup'
    fk = None
    fault = None
    initial = np.array(segments[0]['points'][0][1])

    def description(msg):
        nonlocal fk
        fk = VerifiedFK(msg.data, 'base_link', 'tool0', JOINTS)
        (out / 'robot.urdf').write_text(msg.data)

    def state(msg):
        nonlocal fault
        try:
            order = [list(msg.joint_names).index(j) for j in JOINTS]
            ref = np.array([msg.desired.positions[k] for k in order])
            act = np.array([msg.actual.positions[k] for k in order])
            vel = np.array([msg.actual.velocities[k] for k in order]) if len(msg.actual.velocities) == 6 else np.full(6, np.nan)
            torque = np.array([msg.output.effort[k] for k in order]) if len(msg.output.effort) == 6 else np.full(6, np.nan)
            stamp = msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
            states.append((stamp, act, vel, torque))
            if not np.isfinite(ref).all() or not np.isfinite(act).all():
                fault = 'nonfinite joint state'
            if args.mode == 'effort' and phase != 'startup':
                if not np.isfinite(torque).all() or not np.isfinite(vel).all():
                    fault = 'missing effort output/velocity telemetry'
                elif np.any(np.abs(torque) >= .9 * LIMITS):
                    fault = 'command effort exceeds 90% of model torque limit'
                elif np.max(np.abs(vel)) > 5.0 or np.max(np.abs(ref-act)) > .50:
                    fault = 'velocity/tracking stability gate failed'
            row = dict.fromkeys(CSV_COLUMNS, float('nan'))
            row.update(time_sec=stamp, trajectory_id=phase, controller_mode=args.mode, payload_kg=0.)
            for k, j in enumerate(JOINTS):
                for key, val in [('reference_position_rad', ref[k]), ('actual_position_rad', act[k]),
                                 ('position_error_rad', ref[k]-act[k]), ('actual_velocity_rad_s', vel[k]),
                                 ('commanded_effort_Nm', torque[k])]:
                    row[j+'__'+key] = float(val)
                if len(msg.desired.velocities) == 6:
                    row[j+'__reference_velocity_rad_s'] = msg.desired.velocities[order[k]]
                for key, param in [('Kp', 'p'), ('Ki', 'i'), ('Kd', 'd')]:
                    if j in gains:
                        row[j+'__'+key] = gains[j][param]
            if fk:
                r, a = fk.xyz(ref), fk.xyz(act)
                for k, axis in enumerate('xyz'):
                    row['reference_ee_'+axis+'_m'] = r[k]
                    row['actual_ee_'+axis+'_m'] = a[k]
                    row['ee_error_'+axis+'_mm'] = (r[k]-a[k])*1000
                row['ee_error_3d_mm'] = float(np.linalg.norm(r-a)*1000)
            records.append(row)
        except (IndexError, ValueError) as e:
            fault = str(e)

    node.create_subscription(String, '/robot_description', description,
                             QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL))
    node.create_subscription(JointTrajectoryControllerState, '/arm_controller/controller_state', state, 100)

    def spin_until(predicate, seconds=15, check=True):
        deadline = time.monotonic()+seconds
        while not predicate():
            if check and fault:
                raise RuntimeError(fault)
            if time.monotonic() > deadline:
                raise TimeoutError('wall-time watchdog expired in '+phase)
            rclpy.spin_once(node, timeout_sec=.02)
        if check and fault:
            raise RuntimeError(fault)

    def call(kind, name, request=None):
        client = node.create_client(kind, name)
        if not client.wait_for_service(timeout_sec=10):
            raise RuntimeError('missing service '+name)
        future = client.call_async(request or kind.Request())
        spin_until(future.done, 12)
        result = future.result()
        node.destroy_client(client)
        return result

    def world(command):
        result = subprocess.run(['ign', 'service', '-s', '/world/ur5_pick_place/control',
                                 '--reqtype', 'ignition.msgs.WorldControl', '--reptype', 'ignition.msgs.Boolean',
                                 '--timeout', '2000', '--req', command], capture_output=True, text=True, timeout=4)
        return 'data: true' in result.stdout

    def observe(seconds):
        start = states[-1][0]
        spin_until(lambda: states[-1][0]-start >= seconds, max(15, seconds*5))

    arm = ActionClient(node, FollowJointTrajectory, '/arm_controller/follow_joint_trajectory')

    def execute(points, name, check_result=True):
        nonlocal phase
        phase = name
        if not arm.wait_for_server(timeout_sec=15):
            raise RuntimeError('trajectory action server not available: '+name)
        goal = FollowJointTrajectory.Goal()
        goal.trajectory.joint_names = list(JOINTS)
        for t, q, v, a in points:
            ns = round(t*1e9)
            goal.trajectory.points.append(JointTrajectoryPoint(
                positions=list(q), velocities=list(v), accelerations=list(a),
                time_from_start=Duration(sec=ns//1000000000, nanosec=ns%1000000000)))
        future = arm.send_goal_async(goal)
        spin_until(future.done)
        handle = future.result()
        if not handle.accepted:
            raise RuntimeError('trajectory rejected: '+name)
        result = handle.get_result_async()
        spin_until(result.done, points[-1][0]*5+15)
        response = result.result()
        if check_result and (response.status != 4 or response.result.error_code != 0):
            raise RuntimeError('trajectory failed: '+name+' '+str(response.result))
        return response

    proc = None
    result = {'status': 'failed', 'mode': args.mode,
              'gains': 'not applicable' if args.mode == 'position' else gains,
              'trajectory_sha256': hashlib.sha256(Path(args.path).read_bytes()).hexdigest(),
              'frame': 'base_link', 'tcp': 'tool0', 'payload_kg': 0.,
              'measured_effort': 'unavailable (not synchronized by this runner)',
              'command_effort': 'JTC output.effort, not inferred from gains',
              'safety': 'sampled watchdog, not a hardware torque clamp'}
    log = (out/'launch.log').open('w')
    try:
        proc = subprocess.Popen(['ros2', 'launch', 'ur5_bringup', 'ur5_bringup.launch.py',
                                 'headless:=true', 'rviz:=false', 'controller_mode:='+args.mode,
                                 'controllers_file:='+str(Path(args.config).resolve())],
                                stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        list_client = node.create_client(ListControllers, '/controller_manager/list_controllers')
        if not list_client.wait_for_service(timeout_sec=45):
            raise RuntimeError('controller manager did not initialize')
        expected = {'joint_state_broadcaster': 'active', 'robotiq_gripper_controller': 'active',
                    'arm_controller': 'active'}
        deadline = time.monotonic()+45
        while True:
            future = list_client.call_async(ListControllers.Request())
            spin_until(future.done, 8)
            controllers = future.result().controller
            observed = {c.name: c.state for c in controllers}
            if result.get('startup_controllers') != observed:
                result['startup_controllers'] = observed
                print('Controller startup:', observed, flush=True)
            if all(any(c.name == k and c.state == v for c in controllers) for k, v in expected.items()):
                break
            if time.monotonic() > deadline:
                raise RuntimeError('controller startup states did not converge: ' + str(observed))
            time.sleep(0.5)
            rclpy.spin_once(node, timeout_sec=.1)
        node.destroy_client(list_client)
        print('Expected controllers active!', flush=True)
        if args.mode == 'effort':
            print('Calling get_parameters...', flush=True)
            names = [f'gains.{j}.{key}' for j in JOINTS for key in ('p', 'i', 'd', 'i_clamp', 'ff_velocity_scale')]
            response = call(GetParameters, '/arm_controller/get_parameters', GetParameters.Request(names=names))
            values = [v.double_value for v in response.values]
            wanted = [float(gains[j][key]) for j in JOINTS for key in ('p', 'i', 'd', 'i_clamp', 'ff_velocity_scale')]
            if values != wanted:
                raise RuntimeError('active controller gain readback mismatch')
            result['gain_readback'] = dict(zip(names, values))
        print('Checking controllers and hardware interfaces...', flush=True)
        controllers = call(ListControllers, '/controller_manager/list_controllers').controller
        result['controllers'] = {c.name: {'state': c.state, 'claims': list(c.claimed_interfaces)} for c in controllers}
        interfaces = call(ListHardwareInterfaces, '/controller_manager/list_hardware_interfaces')
        result['command_interfaces'] = {i.name: {'available': i.is_available, 'claimed': i.is_claimed} for i in interfaces.command_interfaces}
        expected_claims = {j+'/'+args.mode for j in JOINTS}
        claims = {i.name for i in interfaces.command_interfaces if i.is_claimed and i.name.split('/')[0] in JOINTS}
        if claims != expected_claims:
            raise RuntimeError('arm command claims mismatch')
        print('Waiting for states and fk...', flush=True)
        spin_until(lambda: len(states) > 25 and fk is not None, seconds=15)
        if np.max(np.abs(states[-1][1]-initial)) > .025:
            raise RuntimeError('fresh initial state differs from saved start: ' + str(list(np.abs(states[-1][1]-initial))))
        phase = 'hold'
        execute([(0., initial, [0.]*6, [0.]*6), (2., initial, [0.]*6, [0.]*6)], 'hold')
        observe(1.)
        if np.max(np.abs(states[-1][1]-initial)) > .05:
            raise RuntimeError('stationary holding drift exceeds 0.05 rad')
        q = initial.copy()
        q[0] += .03
        before = states[-1][1].copy()
        execute([(0., initial, [0.]*6, [0.]*6), (1., q, [0.]*6, [0.]*6)], 'small_joint_1')
        observe(2.)
        result['small_motion_actual_rad'] = float(states[-1][1][0]-before[0])
        if abs(result['small_motion_actual_rad']) < .015:
            raise RuntimeError('actuation gate failed: 0.03 rad command produced less than 0.015 rad motion')
        execute([(0., q, [0.]*6, [0.]*6), (1., initial, [0.]*6, [0.]*6)], 'return_to_start')
        observe(2.)
        if np.max(np.abs(states[-1][1]-initial)) > .01:
            raise RuntimeError('failed to return to repeatable initial pose')
        for segment in segments:
            execute(segment['points'], 'path/'+segment['name'])
        phase = 'settle'
        observe(2.)
        result['status'] = 'passed'
    except Exception as e:
        result['reason'] = str(e)
    finally:
        stop_group(proc)
        log.close()
        with (out/'joint_trajectory_log.csv').open('w') as f:
            writer = csv.DictWriter(f, fieldnames=CSV_COLUMNS)
            writer.writeheader()
            writer.writerows(records)
        path_rows = [r for r in records if r['trajectory_id'].startswith('path/')]
        if path_rows:
            error = np.array([r['ee_error_3d_mm'] for r in path_rows])
            joint_error = np.array([[r[j+'__position_error_rad'] for j in JOINTS] for r in path_rows])
            result['metrics'] = dict(ee_rmse_mm=float(np.sqrt(np.mean(error**2))),
                                     ee_max_mm=float(max(error)), ee_final_path_mm=float(error[-1]),
                                     ee_final_settled_mm=float(records[-1]['ee_error_3d_mm']),
                                     joint_rmse_rad=list(np.sqrt(np.mean(joint_error**2, axis=0))),
                                     cycle_sec=path_rows[-1]['time_sec']-path_rows[0]['time_sec'],
                                     samples=len(path_rows))
        result['samples'] = len(records)
        (out/'result.json').write_text(json.dumps(result, indent=2, allow_nan=False))
        node.destroy_node()
        rclpy.shutdown()
    return 0 if result['status'] == 'passed' else 2


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--path', default=str(ROOT/'path01'))
    parser.add_argument('--output', default=str(ROOT/'experiment_logs/pid_commissioning/trials'))
    parser.add_argument('--mode', choices=['position', 'effort'], default='position')
    parser.add_argument('--config')
    parser.add_argument('--worker', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('--optimize', action='store_true')
    parser.add_argument('--repeats', type=int, default=3)
    parser.add_argument('--max-candidates', type=int, default=12)
    args = parser.parse_args()
    read_path(args.path)
    if args.worker:
        return worker(args)
    if args.repeats < 2 or args.max_candidates < 1:
        parser.error('use at least two repeated trials and one candidate')
    output = Path(args.output).resolve()
    output.mkdir(parents=True, exist_ok=True)
    if (output/'history.json').exists():
        parser.error('use a new output directory; existing evidence is never overwritten')
    history = []

    def trial(mode, gains, label):
        out = output/label
        out.mkdir()
        source = ROOT/'ur5_moveit_config/config'/('ros2_controllers_'+mode+'.yaml')
        config = yaml.safe_load(source.read_text())
        if gains:
            config['arm_controller']['ros__parameters']['gains'] = gains
        (out/'controllers.yaml').write_text(yaml.safe_dump(config, sort_keys=False))
        trial_domain = str((40 + len(history)) % 100)
        env = dict(os.environ, ROS_DOMAIN_ID=trial_domain,
                   IGN_PARTITION=f'ur5_pid_{os.getpid()}_{label}',
                   GZ_PARTITION=f'ur5_pid_{os.getpid()}_{label}')
        command = [sys.executable, str(Path(__file__).resolve()), '--worker', '--mode', mode,
                   '--config', str(out/'controllers.yaml'), '--path', str(Path(args.path).resolve()), '--output', str(out)]
        with (out/'worker.log').open('w') as log:
            proc = subprocess.Popen(command, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            try:
                proc.wait(timeout=180)
            except BaseException:
                stop_group(proc)
                raise
        stop_group(proc)
        # Ensure no stray simulator processes survive between trials
        subprocess.run(['pkill', '-9', '-f', 'ign gazebo'], capture_output=True)
        subprocess.run(['pkill', '-9', '-f', 'robot_state_publisher'], capture_output=True)
        subprocess.run(['pkill', '-9', '-f', 'parameter_bridge'], capture_output=True)
        subprocess.run(['pkill', '-9', '-f', 'spawner'], capture_output=True)
        time.sleep(1)
        result = json.loads((out/'result.json').read_text()) if (out/'result.json').exists() else {'status': 'failed', 'reason': 'worker failed; see worker.log'}
        result['trial'] = label
        history.append(result)
        (output/'history.json').write_text(json.dumps(history, indent=2))
        print(label, result['status'], result.get('reason', result.get('metrics')), flush=True)
        return result

    if args.mode == 'position':
        for repeat in range(args.repeats):
            if trial('position', None, f'position_{repeat:02}')['status'] != 'passed':
                return 2
        if not args.optimize:
            return 0
    best_gains = copy.deepcopy(SEED)
    baseline = trial('effort', best_gains, 'effort_seed')
    if baseline['status'] != 'passed':
        print('No verified stable PID seed: optimization stopped; production configuration unchanged.')
        return 2
    if not args.optimize:
        return 0
    def score(result):
        m = result['metrics']
        return (m['ee_rmse_mm'], m['ee_max_mm'], m['ee_final_settled_mm'])
    best = baseline
    count = 0
    # Coordinate order: prioritize gravity-bearing pitch joints first (shoulder_lift, elbow),
    # then pan, then wrists. Search P (stiffness), I (gravity compensation), then D (damping).
    joints_search = ['shoulder_lift_joint', 'elbow_joint', 'shoulder_pan_joint', 'wrist_1_joint', 'wrist_2_joint', 'wrist_3_joint']
    for key in ('p', 'i'):
        for joint in joints_search:
            index = list(JOINTS).index(joint)
            for factor in (1.2, .85):
                if count >= args.max_candidates:
                    break
                candidate = copy.deepcopy(best_gains)
                value = candidate[joint][key]*factor
                if key == 'i':
                    candidate[joint]['i_clamp'] = float(max(SEED[joint]['i_clamp'], LIMITS[index] * 0.1))
                candidate[joint][key] = float(np.clip(value, BOUNDS[key][0][index], BOUNDS[key][1][index]))
                result = trial('effort', candidate, f'candidate_{count:03}')
                count += 1
                if result['status'] == 'passed' and score(result) < score(best):
                    best, best_gains = result, candidate
    repeated = [trial('effort', best_gains, f'verify_{k:02}') for k in range(args.repeats)]
    if all(r['status'] == 'passed' for r in repeated):
        (output/'best_verified_gains.yaml').write_text(yaml.safe_dump(best_gains, sort_keys=False))
        # Persist gains only as a trial artifact, never silently promote to production.
        print('Repeated gains saved. Compare with BOTH position and effort-seed baselines before acceptance.')
        return 0
    return 2


if __name__ == '__main__':
    raise SystemExit(main())
